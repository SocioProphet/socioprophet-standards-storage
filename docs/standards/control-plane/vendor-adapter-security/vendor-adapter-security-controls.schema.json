{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.ai/schemas/vendor-adapter-security-controls.schema.json",
  "title": "VendorAdapterSecurityControlsChecklist",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_name",
    "title",
    "status",
    "version",
    "scope",
    "objectives",
    "controls",
    "verification_profiles",
    "acceptance_gates"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "artifact_type": {"const": "security_control_checklist"},
    "artifact_name": {"type": "string"},
    "title": {"type": "string"},
    "status": {"type": "string"},
    "version": {"type": "string"},
    "scope": {
      "type": "object",
      "required": ["applies_to", "excludes"],
      "properties": {
        "applies_to": {"type": "array", "items": {"type": "string"}},
        "excludes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "description": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "category", "priority", "normative_statement", "rationale", "check"],
        "properties": {
          "id": {"type": "string", "pattern": "^VAS-[0-9]{3}$"},
          "title": {"type": "string"},
          "category": {"type": "string"},
          "priority": {"type": "string"},
          "normative_statement": {"type": "string"},
          "rationale": {"type": "string"},
          "check": {
            "type": "object",
            "required": ["type", "logic", "evidence"],
            "properties": {
              "type": {"type": "string"},
              "logic": {"type": "string"},
              "evidence": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          },
          "remediation": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": true
      }
    },
    "verification_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "covers"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "covers": {
            "type": "array",
            "items": {"type": "string", "pattern": "^VAS-[0-9]{3}$"}
          }
        },
        "additionalProperties": true
      }
    },
    "acceptance_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "maps_to"],
        "properties": {
          "id": {"type": "string", "pattern": "^AG-[0-9]{3}$"},
          "description": {"type": "string"},
          "maps_to": {
            "type": "array",
            "items": {"type": "string", "pattern": "^VAS-[0-9]{3}$"}
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
