{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.local/schemas/nfrs.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "spec_id": {
      "type": "string",
      "pattern": "^RFC-SPEC-[0-9]{4}$"
    },
    "nfrs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^NFR-[A-Z]+-[0-9]{2}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "security",
              "privacy",
              "performance",
              "maintainability",
              "governance"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "linked_krs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^KR-[A-Z]+-[0-9]{2}$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "category",
          "priority",
          "statement",
          "linked_krs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "spec_id",
    "nfrs"
  ],
  "additionalProperties": false
}
