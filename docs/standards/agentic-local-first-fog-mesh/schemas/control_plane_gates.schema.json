{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.local/schemas/control_plane_gates.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "spec_id": {
      "type": "string",
      "pattern": "^RFC-SPEC-[0-9]{4}$"
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^GATE-[A-Z]+-[0-9]{3}$"
          },
          "component": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "stage": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "enforces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(KR|NFR)-[A-Z]+-[0-9]{2}$"
            }
          },
          "check": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "deny_on_fail": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "rollback": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          }
        },
        "required": [
          "id",
          "component",
          "stage",
          "enforces",
          "check",
          "deny_on_fail",
          "evidence",
          "rollback"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "spec_id",
    "gates"
  ],
  "additionalProperties": false
}
