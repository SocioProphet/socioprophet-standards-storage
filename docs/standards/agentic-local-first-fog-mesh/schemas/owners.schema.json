{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.local/schemas/owners.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "spec_id": {
      "type": "string",
      "pattern": "^RFC-SPEC-[0-9]{4}$"
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "primary_owner": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9 _/&.-]*$"
          },
          "secondary_owners": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9 _/&.-]*$"
            }
          },
          "approves": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "domain",
          "primary_owner",
          "secondary_owners",
          "approves"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "spec_id",
    "owners"
  ],
  "additionalProperties": false
}
