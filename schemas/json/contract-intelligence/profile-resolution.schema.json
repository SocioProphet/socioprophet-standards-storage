{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/contract-intelligence/profile-resolution.schema.json",
  "title": "Contract Intelligence Profile Resolution",
  "type": "object",
  "required": [
    "document_id",
    "language",
    "domain",
    "selected_schema_pack",
    "selected_pattern_pack",
    "selected_model_pack"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "subdomain": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "resolver_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "reason"],
        "properties": {
          "source": { "type": "string" },
          "reason": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "selected_schema_pack": {
      "type": "string"
    },
    "selected_pattern_pack": {
      "type": "string"
    },
    "selected_model_pack": {
      "type": "string"
    },
    "pack_versions": {
      "type": "object",
      "properties": {
        "schema": { "type": "string" },
        "pattern": { "type": "string" },
        "model": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}