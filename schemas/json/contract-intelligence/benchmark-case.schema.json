{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/contract-intelligence/benchmark-case.schema.json",
  "title": "Contract Intelligence Benchmark Case",
  "type": "object",
  "required": ["case_id", "document_ref"],
  "properties": {
    "case_id": { "type": "string" },
    "document_ref": { "type": "string" },
    "gold_profile": {
      "type": "object",
      "properties": {
        "language": { "type": "string" },
        "jurisdiction": { "type": "string" },
        "region": { "type": "string" },
        "domain": { "type": "string" },
        "subdomain": { "type": "string" }
      },
      "additionalProperties": false
    },
    "gold_clauses": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "gold_obligations": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "slice_tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "difficulty": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}