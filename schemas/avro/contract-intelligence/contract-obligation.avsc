    {"name": "clause_id", "type": "string"},
    {"name": "obligation_type", "type": "string"},
    {"name": "actor", "type": ["null", "string"], "default": null},
    {"name": "counterparty", "type": ["null", "string"], "default": null},
    {"name": "beneficiary", "type": ["null", "string"], "default": null},
    {"name": "action", "type": "string"},
    {"name": "object", "type": ["null", "string"], "default": null},
    {"name": "condition", "type": ["null", "string"], "default": null},
    {"name": "exception", "type": ["null", "string"], "default": null},
    {"name": "trigger", "type": ["null", "string"], "default": null},
    {"name": "timeframe", "type": ["null", "string"], "default": null},
    {"name": "effective_window", "type": ["null", {
      "type": "record",
      "name": "EffectiveWindow",
      "fields": [
        {"name": "start", "type": ["null", "string"], "default": null},
        {"name": "end", "type": ["null", "string"], "default": null}
