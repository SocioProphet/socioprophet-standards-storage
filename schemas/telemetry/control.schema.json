{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SocioProphet/socioprophet-standards-storage/schemas/telemetry/control.schema.json",
  "title": "TransparentTelemetryControl",
  "type": "object",
  "required": [
    "control_id",
    "display_name",
    "description",
    "applies_to_planes",
    "default_state",
    "allowed_states",
    "scope"
  ],
  "properties": {
    "control_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "applies_to_planes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "reliability",
          "security_abuse",
          "product_analytics",
          "experimentation",
          "developer_diagnostics",
          "content_receipts"
        ]
      }
    },
    "default_state": {"type": "string", "enum": ["enabled", "disabled", "essential_only", "high_privacy"]},
    "allowed_states": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": ["enabled", "disabled", "essential_only", "high_privacy"]}
    },
    "scope": {"type": "string", "enum": ["global", "workspace", "session", "per_feature"]},
    "dependency_rules": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
