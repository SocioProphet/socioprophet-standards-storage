{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SocioProphet/socioprophet-standards-storage/schemas/telemetry/event_manifest.schema.json",
  "title": "TransparentTelemetryEventManifest",
  "type": "object",
  "required": [
    "event",
    "version",
    "plane",
    "purpose",
    "trigger",
    "essential",
    "user_disable_allowed",
    "fields",
    "forbidden_fields",
    "sampling",
    "retention_days",
    "destinations",
    "owners",
    "review_date",
    "deprecation_status"
  ],
  "properties": {
    "event": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "plane": {
      "type": "string",
      "enum": [
        "reliability",
        "security_abuse",
        "product_analytics",
        "experimentation",
        "developer_diagnostics",
        "content_receipts"
      ]
    },
    "purpose": {"type": "string", "minLength": 1},
    "trigger": {"type": "string", "minLength": 1},
    "essential": {"type": "boolean"},
    "user_disable_allowed": {"type": "boolean"},
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "class", "required", "description", "type", "sensitivity", "transform"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "class": {
            "type": "string",
            "enum": [
              "aggregate",
              "boolean",
              "pseudonymous_identifier",
              "coarse_state",
              "performance_metric",
              "security_signal",
              "content_reference_minimized",
              "ephemeral_runtime",
              "forbidden"
            ]
          },
          "required": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "allowed_values": {"type": "array", "items": {"type": ["string", "number", "boolean"]}},
          "sensitivity": {"type": "string", "enum": ["low", "moderate", "high", "forbidden"]},
          "transform": {"type": "string", "enum": ["none", "hash", "bucket", "truncate", "drop", "aggregate_only"]}
        },
        "additionalProperties": false
      }
    },
    "forbidden_fields": {"type": "array", "items": {"type": "string"}},
    "transform_rules": {"type": "array", "items": {"type": "string"}},
    "sampling": {"type": "string", "minLength": 1},
    "retention_days": {"type": "integer", "minimum": 0},
    "destinations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "owners": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "review_date": {"type": "string", "format": "date"},
    "deprecation_status": {"type": "string", "enum": ["active", "deprecated", "removed"]}
  },
  "additionalProperties": false
}
