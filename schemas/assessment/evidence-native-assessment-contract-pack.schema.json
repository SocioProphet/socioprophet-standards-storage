{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SocioProphet/socioprophet-standards-storage/schemas/assessment/evidence-native-assessment-contract-pack.schema.json",
  "title": "Evidence Native Assessment Contract Pack",
  "description": "Canonical v0 contract pack for evidence-native assessment across the SocioProphet stack.",
  "type": "object",
  "properties": {
    "definitions_version": {
      "type": "string",
      "const": "0.1.0"
    }
  },
  "required": ["definitions_version"],
  "additionalProperties": true,
  "$defs": {
    "digest": {
      "type": "object",
      "properties": {
        "alg": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 }
      },
      "required": ["alg", "digest"],
      "additionalProperties": false
    },
    "toolIdentity": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "properties": {
        "locality_class": {
          "type": "string",
          "enum": ["local", "tenant", "hybrid", "external"]
        },
        "confidentiality": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "retention_policy_ref": { "type": "string", "minLength": 1 }
      },
      "required": ["locality_class", "confidentiality"],
      "additionalProperties": false
    },
    "evidenceLocator": {
      "type": "object",
      "properties": {
        "locator_type": {
          "type": "string",
          "enum": ["page_span", "char_span", "table_cell", "row_key", "json_pointer", "time_span", "opaque"]
        },
        "start_page": { "type": "integer", "minimum": 1 },
        "end_page": { "type": "integer", "minimum": 1 },
        "start_char": { "type": "integer", "minimum": 0 },
        "end_char": { "type": "integer", "minimum": 0 },
        "table_name": { "type": "string" },
        "row_key": { "type": "string" },
        "cell_range": { "type": "string" },
        "json_pointer": { "type": "string" },
        "raw_locator": { "type": "string" }
      },
      "required": ["locator_type"],
      "additionalProperties": false
    },
    "evidenceRef": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "string", "const": "0.1.0" },
        "evidence_ref_id": { "type": "string", "minLength": 1 },
        "source_system": { "type": "string", "minLength": 1 },
        "source_uri": { "type": "string", "minLength": 1 },
        "content_digest": { "$ref": "#/$defs/digest" },
        "locator": { "$ref": "#/$defs/evidenceLocator" },
        "extractor": { "$ref": "#/$defs/toolIdentity" },
        "classification": { "$ref": "#/$defs/classification" },
        "observed_at": { "type": "string", "format": "date-time" },
        "fetched_at": { "type": "string", "format": "date-time" }
      },
      "required": [
        "schema_version",
        "evidence_ref_id",
        "source_system",
        "source_uri",
        "content_digest",
        "locator",
        "extractor",
        "classification"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "string", "const": "0.1.0" },
        "claim_id": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "predicate": { "type": "string", "minLength": 1 },
        "object": {},
        "modality": {
          "type": "string",
          "enum": ["asserted", "negated", "required", "missing", "derived"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "normalized_text": { "type": "string" },
        "claim_type": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "extractor": { "$ref": "#/$defs/toolIdentity" }
      },
      "required": [
        "schema_version",
        "claim_id",
        "subject",
        "predicate",
        "evidence_refs",
        "extractor"
      ],
      "additionalProperties": false
    },
    "claimConflict": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "string", "const": "0.1.0" },
        "conflict_id": { "type": "string", "minLength": 1 },
        "left_claim_ref": { "type": "string", "minLength": 1 },
        "right_claim_ref": { "type": "string" },
        "control_requirement_ref": { "type": "string" },
        "conflict_type": {
          "type": "string",
          "enum": ["contradiction", "scope_mismatch", "staleness", "policy_mismatch", "insufficient_proof"]
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "conflict_id",
        "left_claim_ref",
        "conflict_type",
        "severity",
        "rationale"
      ],
      "additionalProperties": false
    },
    "controlRequirement": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "string", "const": "0.1.0" },
        "control_requirement_id": { "type": "string", "minLength": 1 },
        "framework_id": { "type": "string", "minLength": 1 },
        "framework_version": { "type": "string", "minLength": 1 },
        "control_id": { "type": "string", "minLength": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "required_proof_classes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "decision_policy": {
          "type": "string",
          "enum": ["allow", "warn", "deny", "require_approval", "informational"]
        }
      },
      "required": [
        "schema_version",
        "control_requirement_id",
        "framework_id",
        "framework_version",
        "control_id",
        "row_id",
        "title",
        "required_proof_classes",
        "decision_policy"
      ],
      "additionalProperties": false
    },
    "controlCellEvaluation": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "string", "const": "0.1.0" },
        "evaluation_id": { "type": "string", "minLength": 1 },
        "control_requirement_ref": { "type": "string", "minLength": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "trace_id": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["pass", "partial", "fail", "warn", "not_applicable", "not_evaluated"]
        },
        "decision": {
          "type": "string",
          "enum": ["allow", "warn", "deny", "require_approval", "informational"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "supporting_evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "missing_proof_classes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "claim_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "conflict_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "exception_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "incident_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "rationale": { "type": "string" },
        "evaluator": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "policy_bundle_id": { "type": "string", "minLength": 1 },
            "policy_bundle_version": { "type": "string", "minLength": 1 }
          },
          "required": ["name", "version", "policy_bundle_id", "policy_bundle_version"],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "evaluation_id",
        "control_requirement_ref",
        "row_id",
        "trace_id",
        "status",
        "decision",
        "evaluator"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["fail", "partial", "warn"] }
            },
            "required": ["status"]
          },
          "then": {
            "anyOf": [
              { "required": ["supporting_evidence_refs"] },
              { "required": ["missing_proof_classes"] }
            ]
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "string", "const": "0.1.0" },
        "finding_id": { "type": "string", "minLength": 1 },
        "evaluation_ref": { "type": "string", "minLength": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "disposition": {
          "type": "string",
          "enum": ["open", "accepted_risk", "mitigated", "closed"]
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "remediation": {
          "type": "object",
          "properties": {
            "summary": { "type": "string", "minLength": 1 },
            "owner_ref": { "type": "string" },
            "due_at": { "type": "string", "format": "date-time" },
            "closure_criteria": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1
            }
          },
          "required": ["summary", "closure_criteria"],
          "additionalProperties": false
        },
        "exception_ref": { "type": "string" },
        "incident_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": [
        "schema_version",
        "finding_id",
        "evaluation_ref",
        "row_id",
        "title",
        "severity",
        "disposition",
        "evidence_refs",
        "remediation"
      ],
      "additionalProperties": false
    },
    "assessmentReceipt": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "string", "const": "0.1.0" },
        "receipt_id": { "type": "string", "minLength": 1 },
        "trace_id": { "type": "string", "minLength": 1 },
        "assessment_scope": {
          "type": "object",
          "properties": {
            "subject_id": { "type": "string", "minLength": 1 },
            "subject_kind": { "type": "string", "minLength": 1 },
            "framework_id": { "type": "string", "minLength": 1 },
            "framework_version": { "type": "string", "minLength": 1 }
          },
          "required": ["subject_id", "subject_kind", "framework_id", "framework_version"],
          "additionalProperties": false
        },
        "policy_bundle": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          },
          "required": ["id", "version"],
          "additionalProperties": false
        },
        "evaluator_versions": {
          "type": "object",
          "properties": {
            "claim_extractor": { "type": "string", "minLength": 1 },
            "control_evaluator": { "type": "string", "minLength": 1 },
            "finding_generator": { "type": "string", "minLength": 1 }
          },
          "required": ["claim_extractor", "control_evaluator", "finding_generator"],
          "additionalProperties": false
        },
        "evidence_digests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "evidence_ref_id": { "type": "string", "minLength": 1 },
              "digest": { "$ref": "#/$defs/digest" }
            },
            "required": ["evidence_ref_id", "digest"],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "evaluation_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "finding_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "replay": {
          "type": "object",
          "properties": {
            "manifest_ref": { "type": "string", "minLength": 1 },
            "bundle_ref": { "type": "string", "minLength": 1 },
            "replayable": { "type": "boolean" }
          },
          "required": ["manifest_ref", "replayable"],
          "additionalProperties": false
        },
        "summary": {
          "type": "object",
          "properties": {
            "pass_count": { "type": "integer", "minimum": 0 },
            "partial_count": { "type": "integer", "minimum": 0 },
            "fail_count": { "type": "integer", "minimum": 0 },
            "warn_count": { "type": "integer", "minimum": 0 },
            "finding_count": { "type": "integer", "minimum": 0 },
            "evidence_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "sealed_at": { "type": "string", "format": "date-time" }
      },
      "required": [
        "schema_version",
        "receipt_id",
        "trace_id",
        "assessment_scope",
        "policy_bundle",
        "evaluator_versions",
        "evidence_digests",
        "evaluation_refs",
        "replay",
        "sealed_at"
      ],
      "additionalProperties": false
    },
    "assessmentReport": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "string", "const": "0.1.0" },
        "report_id": { "type": "string", "minLength": 1 },
        "receipt_ref": { "type": "string", "minLength": 1 },
        "subject": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 },
            "display_name": { "type": "string" }
          },
          "required": ["id", "kind"],
          "additionalProperties": false
        },
        "framework": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          },
          "required": ["id", "version"],
          "additionalProperties": false
        },
        "summary": {
          "type": "object",
          "properties": {
            "coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "pass_count": { "type": "integer", "minimum": 0 },
            "partial_count": { "type": "integer", "minimum": 0 },
            "fail_count": { "type": "integer", "minimum": 0 },
            "warn_count": { "type": "integer", "minimum": 0 },
            "finding_count": { "type": "integer", "minimum": 0 },
            "evidence_count": { "type": "integer", "minimum": 0 }
          },
          "required": ["finding_count"],
          "additionalProperties": false
        },
        "finding_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "stakeholder_view": {
          "type": "string",
          "enum": ["operator", "auditor", "executive", "vendor", "regulator"]
        },
        "generated_at": { "type": "string", "format": "date-time" }
      },
      "required": [
        "schema_version",
        "report_id",
        "receipt_ref",
        "subject",
        "framework",
        "summary",
        "stakeholder_view",
        "generated_at"
      ],
      "additionalProperties": false
    }
  }
}
