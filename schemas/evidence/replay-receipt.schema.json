{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/evidence/0.1.0/replay-receipt.schema.json",
  "allOf": [
    { "$ref": "receipt-common.schema.json" },
    {
      "type": "object",
      "required": ["kind", "replayArtifactRef", "reproducible"],
      "properties": {
        "kind": { "const": "ReplayReceipt" },
        "replayArtifactRef": { "type": "string" },
        "reproducible": { "type": "boolean" },
        "inputsDigest": { "type": "string" },
        "policyPackRef": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  ]
}
