{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/evidence/0.1.0/common.schema.json",
  "$defs": {
    "specVersion": {
      "type": "string",
      "pattern": "^0\\.1\\.\\d+$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
