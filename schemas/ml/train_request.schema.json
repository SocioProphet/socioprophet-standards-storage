{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourceos.local/schemas/ml/v1/train_request.schema.json",
  "title": "TrainRequest",
  "type": "object",
  "required": ["datasetRef", "modelSpecRef", "trainingParamsRef", "validationSpecRef"],
  "properties": {
    "datasetRef": { "type": "string", "minLength": 1 },
    "transformSpecRef": { "type": ["string", "null"] },
    "modelSpecRef": { "type": "string", "minLength": 1 },
    "trainingParamsRef": { "type": "string", "minLength": 1 },
    "validationSpecRef": { "type": "string", "minLength": 1 },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
