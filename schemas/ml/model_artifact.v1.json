{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourceos.local/schemas/ml/v1/model_artifact.v1.json",
  "title": "ModelArtifact",
  "type": "object",
  "required": [
    "modelName",
    "modelVersion",
    "artifactHash",
    "artifactUri",
    "trainingJobId",
    "trainingCodeSha",
    "trainingTimestamp",
    "framework",
    "frameworkVersion",
    "metricsRef",
    "sbomRef",
    "dataSources"
  ],
  "properties": {
    "modelName": { "type": "string", "minLength": 1 },
    "modelVersion": { "type": "string", "minLength": 1 },
    "artifactHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "artifactUri": { "type": "string", "minLength": 1 },
    "trainingJobId": { "type": "string", "minLength": 1 },
    "trainingCodeSha": { "type": "string", "pattern": "^[a-f0-9]{7,64}$" },
    "trainingCodePr": { "type": ["integer", "null"], "minimum": 1 },
    "trainingTimestamp": { "type": "string", "format": "date-time" },
    "framework": { "type": "string", "minLength": 1 },
    "frameworkVersion": { "type": "string", "minLength": 1 },
    "trainingParamsRef": { "type": ["string", "null"] },
    "metricsRef": { "type": "string", "minLength": 1 },
    "sbomRef": { "type": "string", "minLength": 1 },
    "sbomSignatureRef": { "type": ["string", "null"] },
    "checkpointRefs": { "type": "array", "items": { "type": "string" } },
    "dataSources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "validationReportRef": { "type": ["string", "null"] },
    "labels": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "additionalProperties": false
}
