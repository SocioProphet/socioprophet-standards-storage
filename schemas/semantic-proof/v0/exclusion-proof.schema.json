{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/proofs/exclusion-proof.schema.json",
  "title": "ExclusionProof",
  "allOf": [
    {
      "$ref": "proof-common.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "proof_type": {
          "const": "exclusion"
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "root_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "tree_size": {
              "type": "integer",
              "minimum": 0
            },
            "query_leaf_key": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "root_hash",
            "tree_size",
            "query_leaf_key"
          ]
        },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "before_first",
                "after_last",
                "between"
              ]
            },
            "left": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "leaf_key": {
                      "type": "string"
                    },
                    "inclusion_proof_ref": {
                      "$ref": "../semantic/common.schema.json#/$defs/Id"
                    }
                  },
                  "required": [
                    "leaf_key",
                    "inclusion_proof_ref"
                  ]
                }
              ]
            },
            "right": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "leaf_key": {
                      "type": "string"
                    },
                    "inclusion_proof_ref": {
                      "$ref": "../semantic/common.schema.json#/$defs/Id"
                    }
                  },
                  "required": [
                    "leaf_key",
                    "inclusion_proof_ref"
                  ]
                }
              ]
            }
          },
          "required": [
            "mode",
            "left",
            "right"
          ]
        },
        "ordering": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "comparator": {
              "const": "utf8-byte-lex"
            }
          },
          "required": [
            "comparator"
          ]
        }
      },
      "required": [
        "subject",
        "boundary",
        "ordering"
      ]
    }
  ],
  "unevaluatedProperties": false
}
